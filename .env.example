# ═══════════════════════════════════════════════════════════════════════
# MCP Gateway — Environment Configuration (Standalone Mode)
# ═══════════════════════════════════════════════════════════════════════
# For Docker Mode A (workspace root), use root .env instead.
# This file is for standalone development only.
# ═══════════════════════════════════════════════════════════════════════

# ── Gateway ───────────────────────────────────────────────────────────
GATEWAY_LISTEN_ADDRESS=:8090
POSTGRES_DSN=host=localhost port=5432 user=arxiv password=arxiv_secret dbname=arxiv_db sslmode=disable

# ── Connection Pool ───────────────────────────────────────────────────
POSTGRES_POOL_MAX_OPEN=25
POSTGRES_POOL_MAX_IDLE=5
POSTGRES_POOL_MAX_LIFETIME=5m
POSTGRES_POOL_MAX_IDLE_TIME=1m
GATEWAY_REQUEST_TIMEOUT=620s
STORE_LOG_TIMEOUT=5s

# ── Service URLs ──────────────────────────────────────────────────────
ARXIV_SERVICE_URL=http://localhost:8080
EVAL_SERVICE_URL=http://localhost:8002
RAG_SERVICE_URL=http://rag-api:8000

# ── Timeouts ──────────────────────────────────────────────────────────
ARXIV_TIMEOUT=600s
EVAL_TIMEOUT=120s
RAG_TIMEOUT=60s

# ── Response Size Limits (bytes) ──────────────────────────────────────
ARXIV_MAX_RESPONSE_BYTES=4194304
EVAL_MAX_RESPONSE_BYTES=1048576
RAG_MAX_RESPONSE_BYTES=4194304

# ── Auth & Rate Limiting ──────────────────────────────────────────────
# Empty = auth disabled (dev mode)
GATEWAY_API_KEYS=sk-dev-example-key
GATEWAY_RATE_LIMIT_RPM=60
GATEWAY_RATE_LIMIT_BURST=10
GATEWAY_AUTH_HEADER_NAME=Authorization
GATEWAY_AUTH_HEADER_PREFIX=Bearer
GATEWAY_ADMIN_KEY=sk-admin-example-key

# Per-key tier assignments: "key1:pro,key2:enterprise"
# GATEWAY_KEY_TIERS=sk-pro-123:pro,sk-ent-456:enterprise
