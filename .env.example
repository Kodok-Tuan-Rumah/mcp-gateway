# Konfigurasi runtime mcp-gateway.
# Salin ke .env lalu sesuaikan. Semua variabel opsional: bila tidak diisi,
# nilai default lokal dipakai (lihat internal/config/config.go).
#
# Verified dengan:
#   make check
#   make demo

# ─────────────────────────── Wajib untuk fitur tertentu ───────────────────────────

# Groq API key untuk orkestrasi /ask. Tanpa ini /ask jatuh ke plan deterministik.
# Ambil di https://console.groq.com
# CATATAN: jangan dibungkus tanda kutip. Nilai akan dipakai apa adanya.
GROQ_API_KEY=gsk_your_actual_key_here

# Model orkestrator. Groq mencabut model dari daftar akses secara berkala;
# model yang sudah dicabut membuat /ask selalu fallback tanpa error yang
# terlihat. Cek model yang tersedia:
#   curl -s -H "Authorization: Bearer $GROQ_API_KEY" \
#     https://api.groq.com/openai/v1/models | python3 -m json.tool
# Default: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# DSN PostgreSQL untuk menyimpan hasil evaluasi. Bila tidak diisi, nilai
# default lokal dipakai. Bila database tidak dapat dijangkau, logging dilewati
# otomatis — gateway tetap menjawab normal.
# CATATAN: di stack workspace, docker-compose meng-inject POSTGRES_DSN sendiri
# (host=ws-postgres); nilai localhost di bawah hanya untuk run standalone.
POSTGRES_DSN=host=localhost port=5432 user=arxiv password=arxiv_secret dbname=arxiv_db sslmode=disable

# ─────────────────────────── Alamat service ───────────────────────────

# Default: http://localhost:8080
ARXIV_SERVICE_URL=http://localhost:8080

# Default: http://localhost:8002
EVAL_SERVICE_URL=http://localhost:8002

# Default: http://rag-api:8000
# CATATAN: backend `research_rag` aktif — rag-api menjawab POST /generate.
# Untuk stack workspace, nilai ini di-inject docker-compose (lihat root docker-compose.yml).
RAG_SERVICE_URL=http://rag-api:8000

# Alamat listen gateway.
# Default: :8090
GATEWAY_LISTEN_ADDRESS=:8090

# ─────────────────────────── Timeout ───────────────────────────
# Format Go duration: 30s, 5m, 1h. Harus bernilai positif.

# Batas satu request end-to-end.
# Default: 620s
GATEWAY_REQUEST_TIMEOUT=620s

# Batas penulisan log evaluasi di background. Detached dari request context,
# jadi nilai ini berdiri sendiri.
# Default: 5s
STORE_LOG_TIMEOUT=5s

# Default: 600s
ARXIV_TIMEOUT=600s

# Default: 120s
EVAL_TIMEOUT=120s

# Default: 10s
RAG_TIMEOUT=10s

# ───────────── Batas ukuran response downstream ─────────────
# Megabyte, bilangan bulat positif. Mencegah satu response besar menghabiskan
# memory gateway.

# Default: 4 (4 MiB)
ARXIV_MAX_RESPONSE_BYTES=4194304

# Default: 1 (1 MiB)
EVAL_MAX_RESPONSE_BYTES=1048576

# Default: 4 (4 MiB)
RAG_MAX_RESPONSE_BYTES=4194304