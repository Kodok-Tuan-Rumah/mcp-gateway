# ═══════════════════════════════════════════════════════════════════════════════════════
# MCP Gateway — Environment Configuration (Mode B: Standalone)
# ═══════════════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Set GATEWAY_API_KEYS and GATEWAY_ADMIN_KEY for production use
# 3. Adjust other values as needed for your environment
# 4. NEVER commit .env — it contains secrets and is gitignored
#
# USAGE:
# - This file is for Mode B (standalone development)
# - For Docker Mode A (workspace root), use root .env instead
# - All services run on localhost with standard ports
#
# ═══════════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 1: GATEWAY SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
GATEWAY_LISTEN_ADDRESS=:8090

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 2: DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (DSN format)
POSTGRES_DSN=host=localhost port=5432 user=arxiv password=arxiv_secret dbname=arxiv_db sslmode=disable

# Connection pool settings
POSTGRES_POOL_MAX_OPEN=25
POSTGRES_POOL_MAX_IDLE=5
POSTGRES_POOL_MAX_LIFETIME=5m
POSTGRES_POOL_MAX_IDLE_TIME=1m

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 3: SERVICE URLs (Localhost)
# ─────────────────────────────────────────────────────────────────────────────────────
# These URLs are for standalone development (services on localhost)
ARXIV_SERVICE_URL=http://localhost:8080
EVAL_SERVICE_URL=http://localhost:8002
RAG_SERVICE_URL=http://rag-api:8000

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 4: BACKEND TIMEOUTS
# ─────────────────────────────────────────────────────────────────────────────────────
GATEWAY_REQUEST_TIMEOUT=620s
STORE_LOG_TIMEOUT=5s
ARXIV_TIMEOUT=600s
EVAL_TIMEOUT=120s
RAG_TIMEOUT=60s

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 5: RESPONSE SIZE LIMITS (in bytes)
# ─────────────────────────────────────────────────────────────────────────────────────
ARXIV_MAX_RESPONSE_BYTES=4194304
EVAL_MAX_RESPONSE_BYTES=1048576
RAG_MAX_RESPONSE_BYTES=4194304

# ─────────────────────────────────────────────────────────────────────────────────────
# SECTION 6: AUTHENTICATION & RATE LIMITING
# ─────────────────────────────────────────────────────────────────────────────────────
# API keys (comma-separated, empty = disabled for dev mode)
GATEWAY_API_KEYS=dev-key
GATEWAY_ADMIN_KEY=dev-admin-key

# Auth header configuration
GATEWAY_AUTH_HEADER_NAME=Authorization
GATEWAY_AUTH_HEADER_PREFIX=Bearer

# Rate limiting (token bucket per client IP)
GATEWAY_RATE_LIMIT_RPM=60
GATEWAY_RATE_LIMIT_BURST=10

# Per-key tier assignments (optional)
# Format: "key1:pro,key2:enterprise"
# Tiers: free (default), pro, enterprise
# GATEWAY_KEY_TIERS=
# ═══════════════════════════════════════════════════════════════════════════════════════
